# Suqafuran — SPA routing + cache control
# Regenerated on every deploy; do not edit the copy on the server directly.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files/directories as-is (assets, images, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Social-media link-preview crawlers don't run JS, so they'd otherwise get
  # the same generic site-wide og:image on every /listing/{id} page. Hand
  # them a tiny server-rendered page with that listing's own photo instead --
  # real visitors never match this and continue straight to the SPA below.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|redditbot|SkypeUriPreview|vkShare|Applebot) [NC]
  RewriteRule ^listing/([0-9]+)/?$ listing-share.php?id=$1 [L,QSA]

  # Everything else goes through index.html so React Router can handle the route
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html must always be revalidated so visitors get the new build
  # (and its reference to the new hashed JS/CSS) immediately after a deploy,
  # instead of a stale cached copy of the old site.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed build assets (filename changes whenever content changes) are safe
  # to cache aggressively and permanently.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # sw.js is a kill-switch for service workers left over from old deploys —
  # it must never be cached, or stuck clients can never fetch the real thing.
  # Placed after the generic .js rule above so it wins (last Header set applies).
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Belt-and-suspenders for servers/proxies that ignore Cache-Control on HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
