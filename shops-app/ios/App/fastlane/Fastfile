require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    api_key = nil
    if ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s != '' && ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s != '' && ENV['APP_STORE_CONNECT_API_KEY'].to_s != ''
      api_key = app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: true
      )
    end

    if is_ci
      keychain_name = "fastlane_tmp_keychain"
      keychain_password = "fastlane_password_123"

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      p12_path = File.expand_path("P72X8KV2P9.p12")
      if ENV['DISTRIBUTION_CERT_P12'].to_s != ''
        p12_path = File.expand_path("dist_cert.p12")
        File.write(p12_path, Base64.decode64(ENV['DISTRIBUTION_CERT_P12']))
      end

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV['DISTRIBUTION_CERT_PASSWORD'] || "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      profile_path = File.expand_path("AppStore_com.suqafuran.app.mobileprovision")
      if ENV['PROVISIONING_PROFILE'].to_s != ''
        profile_path = File.expand_path("dist.mobileprovision")
        File.write(profile_path, Base64.decode64(ENV['PROVISIONING_PROFILE']))
      end

      install_provisioning_profile(path: profile_path)
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: "2969422VU2"
      }
    )

    upload_opts = {
      ipa: "~/Desktop/SuqafuranIPA/Suqafuran.ipa",
      skip_waiting_for_build_processing: true
    }
    upload_opts[:api_key] = api_key if api_key
    upload_to_testflight(upload_opts)
  end
end
