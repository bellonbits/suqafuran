default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    api_key = nil
    if ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s != '' && ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s != '' && ENV['APP_STORE_CONNECT_API_KEY'].to_s != ''
      api_key = app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: true
      )
    end

    if is_ci
      match_opts = {
        type: "appstore",
        app_identifier: "com.suqafuran.app",
        git_url: "https://bellonbits:#{ENV['MATCH_PASSWORD']}@github.com/bellonbits/suqafuran-ios-certs.git",
        storage_mode: "git",
        readonly: false,
        skip_confirmation: true
      }
      match_opts[:api_key] = api_key if api_key
      match(match_opts)
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        stripSwiftSymbols: true,
        uploadBitcode: true,
        teamID: "2969422VU2"
      }
    )

    upload_opts = {
      ipa: "~/Desktop/SuqafuranIPA/Suqafuran.ipa",
      skip_waiting_for_build_processing: true
    }
    upload_opts[:api_key] = api_key if api_key
    upload_to_testflight(upload_opts)
  end
end
