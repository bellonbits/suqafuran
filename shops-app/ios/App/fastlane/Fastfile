require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    api_key = nil
    if ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s != '' && ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s != '' && ENV['APP_STORE_CONNECT_API_KEY'].to_s != ''
      api_key = app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: true
      )
    end

    if is_ci
      sh("rm -rf ~/Library/Developer/Xcode/DerivedData/* || true")

      profile_path = File.expand_path("../AppStore_com.suqafuran.app.mobileprovision", __dir__)
      install_provisioning_profile(path: profile_path) if File.exist?(profile_path)

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: "2969422VU2",
        bundle_identifier: "com.suqafuran.app",
        code_sign_identity: "Apple Distribution"
      )
    end

    build_opts = {
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: "2969422VU2",
        provisioningProfiles: {
          "com.suqafuran.app" => "com.suqafuran.app AppStore"
        }
      }
    }

    build_app(build_opts)
  end
end
