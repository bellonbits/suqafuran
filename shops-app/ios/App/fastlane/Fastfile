require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    api_key = nil
    if ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s != '' && ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s != '' && ENV['APP_STORE_CONNECT_API_KEY'].to_s != ''
      api_key = app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: true
      )
    end

    if is_ci
      keychain_name = "fastlane_tmp_keychain"
      keychain_password = "fastlane_password_123"

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      p12_path = File.expand_path("../P72X8KV2P9.p12", __dir__)
      if ENV['DISTRIBUTION_CERT_P12'].to_s != ''
        p12_path = File.expand_path("dist_cert.p12")
        File.write(p12_path, Base64.decode64(ENV['DISTRIBUTION_CERT_P12']))
      end

      # Check if p12_path is actually a PEM formatted private key
      p12_content = File.read(p12_path)
      if p12_content.include?("BEGIN RSA PRIVATE KEY") || p12_content.include?("BEGIN PRIVATE KEY")
        cer_path = File.expand_path("../P72X8KV2P9.cer", __dir__)
        cert_pem = File.expand_path("cert_temp.pem")

        if File.exist?(cer_path)
          sh("openssl x509 -in #{cer_path} -inform DER -out #{cert_pem}")
          valid_p12 = File.expand_path("converted_dist.p12")
          sh("openssl pkcs12 -export -out #{valid_p12} -inkey #{p12_path} -in #{cert_pem} -passout pass:'' -legacy")
          p12_path = valid_p12
        end
      end

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV['DISTRIBUTION_CERT_PASSWORD'] || "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      update_keychain_partition_list(
        keychain_name: keychain_name,
        keychain_password: keychain_password,
        dont_autorange: true
      )

      profile_path = File.expand_path("../AppStore_com.suqafuran.app.mobileprovision", __dir__)
      if ENV['PROVISIONING_PROFILE'].to_s != ''
        profile_path = File.expand_path("dist.mobileprovision")
        File.write(profile_path, Base64.decode64(ENV['PROVISIONING_PROFILE']))
      end

      install_provisioning_profile(path: profile_path)

      prof_spec = ENV['PROVISIONING_PROFILE_SPECIFIER'] || lane_context[SharedValues::SIGH_NAME] || lane_context[SharedValues::SIGH_UDID] || "com.suqafuran.app AppStore"

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: "2969422VU2",
        bundle_identifier: "com.suqafuran.app",
        profile_name: prof_spec,
        code_sign_identity: "Apple Distribution"
      )
    end

    prof_spec = ENV['PROVISIONING_PROFILE_SPECIFIER'] || lane_context[SharedValues::SIGH_NAME] || lane_context[SharedValues::SIGH_UDID] || "com.suqafuran.app AppStore"

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      xcargs: "PROVISIONING_PROFILE_SPECIFIER='#{prof_spec}' CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM='2969422VU2'",
      export_options: {
        signingStyle: "manual",
        teamID: "2969422VU2",
        provisioningProfiles: {
          "com.suqafuran.app" => prof_spec
        }
      }
    )

    upload_opts = {
      ipa: "~/Desktop/SuqafuranIPA/Suqafuran.ipa",
      skip_waiting_for_build_processing: true
    }
    upload_opts[:api_key] = api_key if api_key
    upload_to_testflight(upload_opts)
  end
end
