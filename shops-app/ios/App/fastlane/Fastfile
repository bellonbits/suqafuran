default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    if is_ci
      # Use match to sync certificates and provisioning profiles
      # match handles keychain setup, so we don't need setup_ci
      match(
        type: "appstore",
        app_identifier: "com.suqafuran.app",
        git_url: "https://bellonbits:#{ENV['MATCH_PASSWORD']}@github.com/bellonbits/suqafuran-ios-certs.git",
        storage_mode: "git",
        readonly: false,
        skip_confirmation: true,
        api_key: nil
      )
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        stripSwiftSymbols: true,
        uploadBitcode: true,
        teamID: "2969422VU2"
      }
    )

    upload_to_testflight(
      ipa: "~/Desktop/SuqafuranIPA/Suqafuran.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
