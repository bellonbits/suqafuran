require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :build do
    api_key = nil
    if ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s != '' && ENV['APP_STORE_CONNECT_ISSUER_ID'].to_s != '' && ENV['APP_STORE_CONNECT_API_KEY'].to_s != ''
      api_key = app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: true
      )
    end

    if is_ci
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "App.xcodeproj",
        team_id: "2969422VU2",
        bundle_identifier: "com.suqafuran.app"
      )
    end

    build_opts = {
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      output_directory: "~/Desktop/SuqafuranIPA",
      output_name: "Suqafuran.ipa",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "2969422VU2"
      }
    }

    build_app(build_opts)
  end
end
