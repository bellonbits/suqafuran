default_platform(:ios)

platform :ios do
  desc "Build IPA"

  lane :build do
    if is_ci
      sh("rm -rf ~/Library/Developer/Xcode/DerivedData/* || true")

      update_code_signing_settings(
        use_automatic_signing: true,
        path: "App.xcodeproj",
        team_id: "2969422VU2",
        bundle_identifier: "com.suqafuran.app"
      )
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      sdk: "iphoneos",
      export_method: "app-store",
      output_directory: File.expand_path("~/Desktop/SuqafuranIPA"),
      output_name: "Suqafuran.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "2969422VU2"
      }
    )
  end
end
